{
  "name": "@sker/di",
  "version": "1.0.0",
  "description": "现代化的 TypeScript 依赖注入(DI)系统，借鉴 Angular DI 核心设计理念",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build": "tsup",
    "build:watch": "tsup --watch",
    "build:tsc": "tsc",
    "dev": "tsup --watch"
  },
  "keywords": [
    "dependency-injection",
    "di",
    "typescript",
    "angular",
    "ioc",
    "container"
  ],
  "author": "imeepos",
  "license": "ISC",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "jest": "^30.1.2",
    "ts-jest": "^29.4.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2"
  }
}
